# Python build and cache artefacts
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.venv/
venv/

# Experiment output. The raw synthetic tables are regenerated by the
# documented runners and are deliberately kept out of repository history;
# only the compact frozen products under results/frozen/ are committed.
results/*
!results/frozen/
schedules/

# LaTeX build artefacts
*.aux
*.bbl
*.blg
*.log
*.out
*.synctex.gz
*.toc
